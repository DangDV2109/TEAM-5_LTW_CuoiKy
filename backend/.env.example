PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Local hoac MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/ptit_cinema

# JWT Secret
JWT_SECRET=ptit_cinema_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# PayOS Payment Gateway (Dang ky mien phi tai https://payos.vn de lay key, hoac de trong de dung che do Gia lap)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# VietQR Bank Account (Tao QR chuyen khoan truc tiep qua Napas)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=PTIT CINEMA

# Nodemailer Email Service (Gmail hoac SMTP de gui ve dien tu)
EMAIL_SERVICE=gmail
EMAIL_USER=ptit.cinema.service@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="PTIT Cinema" <ptit.cinema.service@gmail.com>
