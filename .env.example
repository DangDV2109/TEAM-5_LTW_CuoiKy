# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env lên git)
PORT=5000
NODE_ENV=development

# Chuỗi kết nối MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ptit_cine?retryWrites=true&w=majority

# Secret ký JWT - đặt chuỗi dài, ngẫu nhiên (>= 32 ký tự)
JWT_SECRET=doi_thanh_chuoi_bi_mat_that_dai_va_ngau_nhien
JWT_EXPIRES_IN=7d

# Origin của frontend (Vite chạy cổng 3000)
CLIENT_URL=http://localhost:3000

# Tài khoản admin đầu tiên (dùng cho: npm run seed:admin)
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=admin@ptitcine.vn
ADMIN_PASSWORD=Admin12345
